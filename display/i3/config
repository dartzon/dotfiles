################################################################################################
## i3 config file (v4)
##
## Please see http://i3wm.org/docs/userguide.html for a complete reference!
################################################################################################

################################################################################################
## General configuration
################################################################################################

# Use "Windows key" in the keyboard as the mod key
set $mod Mod4
# As of i3 v4.13, whether the keypad vernum key is pressed or not is also
# taken into consideration, and thus must be present in the keybindings.
set $vernum Mod2

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango: Terminess Nerd Font Propo Regular 10

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Prevent the mouse cursor from jumping to the other window when switched to
mouse_warping none

# Prevent the mouse cursor's movements from changing the window focus
focus_follows_mouse false

################################################################################################
## Programs autostart
################################################################################################

##==================================================
## Essentials
##==================================================

# Swap Ctrl and Caps-key
exec_always --no-startup-id setxkbmap -option ctrl:nocaps

# Run sxhkd
exec --no-startup-id sxhkd

# Run Polybar
exec_always --no-startup-id /bin/bash ~/.dotfiles/display/polybar/launch.sh

# Load the wallpaper
exec_always --no-startup-id feh --bg-center ~/.dotfiles/display/wallpapers/retro-linux.png

##==================================================
## Goodies
##==================================================

# Always enable the numpad
exec --no-startup-id numlockx on

# Run Pika backup's daemon process
exec --no-startup-id pika-backup-monitor

# Setup Kensington Expert trackball
exec_always --no-startup-id /bin/bash ~/.dotfiles/display/i3/Kensington_Expert_Setup.sh

################################################################################################
## Looks
################################################################################################

# Setting border style to pixel eliminates title bars in split layouts
default_border pixel 3

# Colors and status Bar
set $black	#002B36
set $white	#839496
set $gray	#CCCCCC
set $darkgray	#666666
set $green      #799F26
set $blue	#4D73AA
set $purple	#8473A7
set $red	#B58900
set $orange	#E59847
set $cyan	#2AA198
set $dark	#00252E

#class                  border  backgr. text    indicator
client.focused			$white  $white  $dark    $dark
client.unfocused		$dark   $dark   $white   $white
client.focused_inactive	$dark   $dark   $white  $dark
client.urgent			$orange $orange $dark    $white

################################################################################################
## Workspace Configuration
################################################################################################

# Remember last workspace to jump back to
workspace_auto_back_and_forth yes

set_from_resource $primary_monitor i3wm.primary_monitor DP0
set_from_resource $secondary_monitor i3wm.secondary_monitor DP0
set_from_resource $vertical_monitor i3wm.vertical_monitor DP0

##==================================================
## Primary monitor
##==================================================

# Workspaces
set $tag1  "1:󰲠"
set $tag2  "2:󰲢"
set $tag3  "3:󰲤"
set $tag4  "4:󰲦"
set $tag5  "5:󰲨"
set $tag6  "6:󰲪"
set $tag7  "7:󰲬"
set $tag8  "8:󰲮"
set $tag9  "9:󰲰"
set $tag10 "10:󰿬"

# workspace $tag1 output $primary_monitor
# workspace $tag2 output $primary_monitor
# workspace $tag3 output $primary_monitor
# workspace $tag4 output $primary_monitor
# workspace $tag5 output $primary_monitor
# workspace $tag6 output $primary_monitor
# workspace $tag7 output $primary_monitor
# workspace $tag8 output $primary_monitor
# workspace $tag9 output $primary_monitor
# workspace $tag10 output $primary_monitor


##==================================================
## Secondary monitor
##==================================================

# Workspaces
set $tag11  "11:󰼏"
set $tag12  "12:󰼐"
set $tag13  "13:󰼑"
set $tag14  "14:󰼒"
set $tag15  "15:󰼓"
set $tag16  "16:󰼔"
set $tag17  "17:󰼕"
set $tag18  "18:󰼖"
set $tag19  "19:󰼗"
set $tag20  "20:󰿪"

# workspace $tag11 output $secondary_monitor
# workspace $tag12 output $secondary_monitor
# workspace $tag13 output $secondary_monitor
# workspace $tag14 output $secondary_monitor
# workspace $tag15 output $secondary_monitor
# workspace $tag16 output $secondary_monitor
# workspace $tag17 output $secondary_monitor
# workspace $tag18 output $secondary_monitor
# workspace $tag19 output $secondary_monitor
# workspace $tag20 output $secondary_monitor

##==================================================
## Vertical monitor
##==================================================

# Only one workspace
set $code_ws  "21:code"
workspace $code_ws output $vertical_monitor

################################################################################################
## Keyboard bindings
################################################################################################

##==================================================
## i3wm
##==================================================

# Reload the configuration file
bindsym $mod+Shift+c reload
# Restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r exec --no-startup-id "i3-msg restart;pkill -usr1 -x sxhkd;notify-send -u normal 'i3wm' 'Configuration reloaded'"

##==================================================
## Window navigation and manipulation
##==================================================

# Kill focused window
bindsym $mod+Escape kill
bindsym XF86Close kill

# Change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Change window position
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split in horizontal orientation
bindsym $mod+h split h

# Split in vertical orientation
bindsym $mod+v split v

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+n layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+w floating toggle

# Change focus between tiling / floating windows
bindsym $mod+w focus mode_toggle

# Focus the parent container
bindsym $mod+q focus parent

##==================================================
## Workspace navigation
##==================================================

##--------------------------------------------------
## Primary workspace
##--------------------------------------------------
# Switch workspace
bindsym $mod+$vernum+KP_1 workspace $tag1
bindsym $mod+$vernum+KP_2 workspace $tag2
bindsym $mod+$vernum+KP_3 workspace $tag3
bindsym $mod+$vernum+KP_4 workspace $tag4
bindsym $mod+$vernum+KP_5 workspace $tag5
bindsym $mod+$vernum+KP_6 workspace $tag6
bindsym $mod+$vernum+KP_7 workspace $tag7
bindsym $mod+$vernum+KP_8 workspace $tag8
bindsym $mod+$vernum+KP_9 workspace $tag9
bindsym $mod+$vernum+KP_0 workspace $tag10

# Move windows
bindsym $mod+Shift+$vernum+KP_End move container to workspace $tag1
bindsym $mod+Shift+$vernum+KP_Down move container to workspace $tag2
bindsym $mod+Shift+$vernum+KP_Next move container to workspace $tag3
bindsym $mod+Shift+$vernum+KP_Left move container to workspace $tag4
bindsym $mod+Shift+$vernum+KP_Begin move container to workspace $tag5
bindsym $mod+Shift+$vernum+KP_Right move container to workspace $tag6
bindsym $mod+Shift+$vernum+KP_Home move container to workspace $tag7
bindsym $mod+Shift+$vernum+KP_Up move container to workspace $tag8
bindsym $mod+Shift+$vernum+KP_Prior move container to workspace $tag9
bindsym $mod+Shift+$vernum+KP_Insert move container to workspace $tag10

##--------------------------------------------------
## Secondary workspace
##--------------------------------------------------
# Switch workspace
bindsym $mod+1 workspace $tag11
bindsym $mod+2 workspace $tag12
bindsym $mod+3 workspace $tag13
bindsym $mod+4 workspace $tag14
bindsym $mod+5 workspace $tag15
bindsym $mod+6 workspace $tag16
bindsym $mod+7 workspace $tag17
bindsym $mod+8 workspace $tag18
bindsym $mod+9 workspace $tag19
bindsym $mod+0 workspace $tag20
 
# Move windows
bindsym $mod+Shift+exclam move container to workspace $tag11
bindsym $mod+Shift+at move container to workspace $tag12
bindsym $mod+Shift+numbersign move container to workspace $tag13
bindsym $mod+Shift+dollar move container to workspace $tag14
bindsym $mod+Shift+percent move container to workspace $tag15
bindsym $mod+Shift+asciicircum move container to workspace $tag16
bindsym $mod+Shift+ampersand move container to workspace $tag17
bindsym $mod+Shift+asterisk move container to workspace $tag18
bindsym $mod+Shift+parenleft move container to workspace $tag19
bindsym $mod+Shift+parenright move container to workspace $tag20

##--------------------------------------------------
## Vertical workspace
##--------------------------------------------------
bindsym $mod+Home workspace $code_ws

##--------------------------------------------------
## Primary workspace - No separate numpad
##--------------------------------------------------
# Switch workspace
bindsym $mod+ctrl+1 workspace $tag1
bindsym $mod+ctrl+2 workspace $tag2
bindsym $mod+ctrl+3 workspace $tag3
bindsym $mod+ctrl+4 workspace $tag4
bindsym $mod+ctrl+5 workspace $tag5
bindsym $mod+ctrl+6 workspace $tag6
bindsym $mod+ctrl+7 workspace $tag7
bindsym $mod+ctrl+8 workspace $tag8
bindsym $mod+ctrl+9 workspace $tag9
bindsym $mod+ctrl+0 workspace $tag10
 
# Move windows
bindsym $mod+ctrl+Shift+exclam move container to workspace $tag1
bindsym $mod+ctrl+Shift+at move container to workspace $tag2
bindsym $mod+ctrl+Shift+numbersign move container to workspace $tag3
bindsym $mod+ctrl+Shift+dollar move container to workspace $tag4
bindsym $mod+ctrl+Shift+percent move container to workspace $tag5
bindsym $mod+ctrl+Shift+asciicircum move container to workspace $tag6
bindsym $mod+ctrl+Shift+ampersand move container to workspace $tag7
bindsym $mod+ctrl+Shift+asterisk move container to workspace $tag8
bindsym $mod+ctrl+Shift+parenleft move container to workspace $tag9
bindsym $mod+ctrl+Shift+parenright move container to workspace $tag10

##--------------------------------------------------
## Other
##--------------------------------------------------

# Restart emacs daemon
# bindsym $mod+Shift+e exec --no-startup-id "systemctl --user restart emacs;notify-send -u normal 'emacs daemon' 'Emacs configuration reloaded'"

################################################################################################
## Custom modes
################################################################################################
set $sysmenu "  [p]oweroff   [r]eboot   [l]ogout   [s]uspend   [h]ibernate"
bindsym $mod+Delete mode $sysmenu

mode $sysmenu
{
    bindsym p exec --no-startup-id /bin/bash ~/.dotfiles/display/i3/i3exit shutdown, mode "default"
    bindsym r exec --no-startup-id /bin/bash ~/.dotfiles/display/i3/i3exit reboot, mode "default"
    bindsym l exec --no-startup-id /bin/bash ~/.dotfiles/display/i3/i3exit logout, mode "default"
    bindsym s exec --no-startup-id /bin/bash ~/.dotfiles/display/i3/i3exit suspend, mode "default"
    bindsym h exec --no-startup-id /bin/bash ~/.dotfiles/display/i3/i3exit hibernate, mode "default"

    # back to normal : Enter or Escape
    bindsym Return    mode "default"
    bindsym Escape    mode "default"
}

# resize window (you can also use the mouse for that)
mode "resize" {
    # same bindings, but for the arrow keys
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"
